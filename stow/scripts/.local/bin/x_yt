#!/usr/bin/env python3
# x_yt - Interactive YouTube/video downloader wrapper (yt-dlp)

import glob
import importlib.util
import os
import re
import subprocess
import sys
import shutil
from datetime import datetime, timezone

if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
    print("Usage: x_yt")
    print("Interactive YouTube/video downloader (yt-dlp)")
    print()
    print("Supports single videos, playlists, multiple playlists, and full channels.")
    print("Browser cookies are required for YouTube (PO token / SABR bypass).")
    sys.exit(0)

MAX_VERSION_AGE_DAYS = 30

# Stamped by check_ytdlp_version() when an update attempt confirms no newer
# version exists on PyPI. Suppresses the nag until a newer release ships.
_VERSION_SKIP_FILE = os.path.expanduser("~/.config/x_yt/skip_version_nag")

_EXTRA_NODE_DIRS = [
    os.path.expanduser("~/.nvm/versions/node/*/bin"),
    "/usr/local/bin",
    "/usr/bin",
]

SUPPORTED_BROWSERS = ["firefox", "chrome", "chromium", "brave", "opera", "vivaldi", "safari"]

# Output templates — playlists and channels get subdirectories automatically.
_TMPL_SINGLE   = "%(title)s [%(id)s].%(ext)s"
_TMPL_PLAYLIST = "%(playlist_title)s/%(title)s [%(id)s].%(ext)s"
_TMPL_CHANNEL  = "%(uploader)s/%(playlist_title)s/%(title)s [%(id)s].%(ext)s"


# ---------------------------------------------------------------------------
# Environment helpers
# ---------------------------------------------------------------------------

def _version_date(version_str: str) -> datetime | None:
    m = re.fullmatch(r"(\d{4})\.(\d{1,2})\.(\d{1,2})(?:\.\d+)?", version_str.strip())
    if not m:
        return None
    try:
        return datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), tzinfo=timezone.utc)
    except ValueError:
        return None


def _find_node() -> str | None:
    """Return the path to Node.js ≥ v22, or None."""
    candidates: list[str] = []
    for name in ("node", "nodejs"):
        path = shutil.which(name)
        if path:
            candidates.append(path)
    for pattern in _EXTRA_NODE_DIRS:
        for directory in glob.glob(pattern):
            for name in ("node", "nodejs"):
                full = os.path.join(directory, name)
                if os.path.isfile(full) and os.access(full, os.X_OK):
                    candidates.append(full)

    for path in candidates:
        try:
            out = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=3)
            major = int(out.stdout.strip().lstrip("v").split(".")[0])
            if major >= 22:
                return path
        except Exception:
            continue
    return None


def check_ytdlp_version() -> None:
    try:
        def _current_version() -> str:
            r = subprocess.run(["yt-dlp", "--version"], capture_output=True, text=True, timeout=5)
            return r.stdout.strip()

        version_str = _current_version()
        version_date = _version_date(version_str)
        if version_date is None:
            return

        age_days = (datetime.now(timezone.utc) - version_date).days
        if age_days <= MAX_VERSION_AGE_DAYS:
            return

        # If a previous update attempt confirmed this IS the latest stable,
        # suppress the nag until a newer version actually ships.
        if os.path.exists(_VERSION_SKIP_FILE):
            skipped_ver = open(_VERSION_SKIP_FILE).read().strip()
            if skipped_ver == version_str:
                return

        print(f"\n  WARNING: yt-dlp v{version_str} is {age_days} days old.")
        print("  Outdated versions often break against YouTube's changing restrictions.")
        ans = input("  Update now? [Y/n] ").strip().lower()
        if ans not in ("", "y", "yes"):
            return

        print("  Updating yt-dlp + yt-dlp-ejs...")
        subprocess.run(
            [sys.executable, "-m", "pip", "install", "-U", "yt-dlp[default]"],
            check=False,
        )

        new_version = _current_version()
        if new_version == version_str:
            print(f"  Already on the latest stable release ({version_str}).")
            print("  Suppressing this warning until a newer version ships.")
            os.makedirs(os.path.dirname(_VERSION_SKIP_FILE), exist_ok=True)
            open(_VERSION_SKIP_FILE, "w").write(version_str)
        else:
            # Newer version installed — clear any stale skip stamp.
            if os.path.exists(_VERSION_SKIP_FILE):
                os.remove(_VERSION_SKIP_FILE)
            print(f"  Updated to v{new_version}.")
        print()
    except Exception:
        pass


def check_dependencies() -> None:
    """Catch missing yt-dlp-ejs and Node v22+ before the first download."""
    if importlib.util.find_spec("yt_dlp_ejs") is None:
        print("\n  WARNING: yt-dlp-ejs is not installed.")
        print("  Without it, YouTube n-challenge solving fails and only thumbnails download.")
        ans = input("  Install now? [Y/n] ").strip().lower()
        if ans in ("", "y", "yes"):
            print("  Installing yt-dlp[default]...")
            subprocess.run(
                [sys.executable, "-m", "pip", "install", "-U", "yt-dlp[default]"],
                check=False,
            )
            print()

    if _find_node() is None:
        print("\n  WARNING: No Node.js v22+ found.")
        print("  yt-dlp's EJS solver needs Node ≥ v22.")
        print("  Install: nvm install 22   OR   sudo apt install nodejs")
        print("  (Deno also works: https://docs.deno.com/runtime/getting_started/installation/)")
        input("  Press Enter to continue anyway (downloads may fail)...")
        print()


# ---------------------------------------------------------------------------
# Browser helpers
# ---------------------------------------------------------------------------

def _detect_installed_browsers() -> list[str]:
    found = []
    for b in SUPPORTED_BROWSERS:
        binary = "google-chrome" if b == "chrome" else b
        if shutil.which(binary) or shutil.which(b):
            found.append(b)
    return found


def ask_browser_cookies() -> str | None:
    available = _detect_installed_browsers()
    print("\n--- Browser Cookies (YouTube Authentication) ---")
    print("YouTube requires an authenticated session to download most content.")
    print("yt-dlp reads cookies directly from your browser (no manual export needed).")
    print()

    if not available:
        print("No supported browsers detected. Proceeding without cookies (may fail).")
        return None

    options = available + ["skip (no cookies — may fail)"]
    for i, opt in enumerate(options, 1):
        marker = " [recommended]" if i == 1 else ""
        print(f"  {i}. {opt}{marker}")

    while True:
        choice = input("\nChoose browser [1]: ").strip()
        if choice == "":
            return available[0]
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(available):
                return available[idx]
            if idx == len(available):
                return None
        except ValueError:
            pass
        print("  Invalid choice, try again.")


# ---------------------------------------------------------------------------
# Main downloader
# ---------------------------------------------------------------------------

class EasyDownloader:
    def __init__(self):
        if shutil.which("yt-dlp"):
            self.downloader = "yt-dlp"
        elif shutil.which("youtube-dl"):
            self.downloader = "youtube-dl"
        else:
            print("Error: Neither 'yt-dlp' nor 'youtube-dl' found.", file=sys.stderr)
            print("Install with: pip install yt-dlp", file=sys.stderr)
            input("Press Enter to exit...")
            sys.exit(1)

        print(f"Found downloader: {self.downloader}")

        if self.downloader == "yt-dlp":
            check_ytdlp_version()
            check_dependencies()
            self.browser = ask_browser_cookies()
        else:
            self.browser = None

        # Cache node path — looked up once, reused across all downloads.
        self._node_path = _find_node()

    # ------------------------------------------------------------------
    # Input helpers
    # ------------------------------------------------------------------

    def clear_screen(self):
        os.system("cls" if os.name == "nt" else "clear")

    def get_save_directory(self) -> str:
        print("\nWhere do you want to save the files?")
        print("Leave blank to use the current folder.")
        path = input("Path > ").strip()
        if path:
            full_path = os.path.expanduser(path)
            os.makedirs(full_path, exist_ok=True)
            return full_path
        return os.getcwd()

    def collect_urls(self) -> list[str]:
        """Collect one or more URLs; blank line ends input."""
        urls: list[str] = []
        print("\nEnter URLs one per line, blank line when done:")
        while True:
            url = input(f"  URL {len(urls) + 1} > ").strip()
            if not url:
                break
            urls.append(url)
        return urls

    def ask_archive(self, save_dir: str) -> str | None:
        """Offer a download archive to skip already-downloaded files."""
        ans = input("Use download archive? (skips files you already have) [Y/n] ").strip().lower()
        if ans in ("", "y", "yes"):
            path = os.path.join(save_dir, ".yt-dlp-archive.txt")
            print(f"  Archive: {path}")
            return path
        return None

    # ------------------------------------------------------------------
    # Command building
    # ------------------------------------------------------------------

    def _base_flags(self, template: str, archive_path: str | None = None) -> list[str]:
        flags = [
            "-o", template,
            "--retries", "5",
            "--fragment-retries", "5",
            "--file-access-retries", "3",
        ]
        if self._node_path:
            flags += ["--js-runtimes", f"node:{self._node_path}"]
        if self.browser:
            flags += ["--cookies-from-browser", self.browser]
        if archive_path:
            flags += ["--download-archive", archive_path]
        return flags

    def run_command(self, args: list[str], cwd: str | None = None) -> None:
        cmd = [self.downloader] + args
        # Print a readable summary, hiding long paths from node/cookie flags.
        display = " ".join(
            a for a in cmd
            if not a.startswith("/home") and not a.startswith("/usr/share/cursor")
        )
        print(f"\nRunning: {display}")
        print("--- Starting Download ---")
        try:
            subprocess.run(cmd, cwd=cwd, check=True)
            print("--- Finished Successfully! ---")
        except subprocess.CalledProcessError as e:
            print(f"--- Download ended with error (exit code {e.returncode}) ---",
                  file=sys.stderr)
        except FileNotFoundError:
            print(f"Error: Could not execute '{self.downloader}'.", file=sys.stderr)

    def run_batch(self, urls: list[str], args_fn, cwd: str) -> None:
        """Run the same download args against each URL in sequence."""
        total = len(urls)
        for i, url in enumerate(urls, 1):
            print(f"\n{'='*60}")
            print(f"  [{i}/{total}] {url}")
            print(f"{'='*60}")
            self.run_command(args_fn(url), cwd=cwd)

    # ------------------------------------------------------------------
    # Menu
    # ------------------------------------------------------------------

    def menu(self) -> None:
        while True:
            self.clear_screen()
            status = f"cookies: {self.browser}" if self.browser else "cookies: none (may fail)"
            print(f"=== Easy YouTube Downloader ({self.downloader} | {status}) ===")
            print()
            print("  Single video")
            print("    1. Best quality (video + audio)")
            print("    2. Audio only (MP3)")
            print()
            print("  Playlist")
            print("    3. Best quality")
            print("    4. Audio only (MP3)")
            print()
            print("  Multiple playlists  (enter URLs one by one)")
            print("    5. Best quality")
            print("    6. Audio only (MP3)")
            print()
            print("  Channel / Creator  (all videos from a @channel URL)")
            print("    7. Best quality")
            print("    8. Audio only (MP3)")
            print()
            print("    9. Custom format (advanced)")
            print("    C. Change browser / cookie source")
            print("    Q. Quit")

            choice = input("\nSelect an option: ").strip().lower()

            if choice == "q":
                break

            if choice == "c":
                self.browser = ask_browser_cookies()
                continue

            if choice not in ("1", "2", "3", "4", "5", "6", "7", "8", "9"):
                continue

            # --- URL collection ---
            if choice in ("5", "6"):
                urls = self.collect_urls()
            elif choice in ("7", "8"):
                url = input("Enter channel URL (e.g. https://www.youtube.com/@channel): ").strip()
                urls = [url] if url else []
            else:
                url = input("Enter URL: ").strip()
                urls = [url] if url else []

            if not urls:
                continue

            save_dir = self.get_save_directory()

            # --- Download archive (offered for multi-item downloads) ---
            archive = None
            if choice in ("3", "4", "5", "6", "7", "8"):
                archive = self.ask_archive(save_dir)

            # --- Build args and run ---
            if choice in ("1",):
                base = self._base_flags(_TMPL_SINGLE, archive)
                self.run_command(base + ["-f", "bestvideo+bestaudio/best",
                                         "--merge-output-format", "mp4", urls[0]], cwd=save_dir)

            elif choice in ("2",):
                base = self._base_flags(_TMPL_SINGLE, archive)
                self.run_command(base + ["-x", "--audio-format", "mp3",
                                         "--audio-quality", "0", urls[0]], cwd=save_dir)

            elif choice in ("3", "5"):
                base = self._base_flags(_TMPL_PLAYLIST, archive)
                extra = ["--yes-playlist", "-f", "bestvideo+bestaudio/best",
                         "--merge-output-format", "mp4"]
                self.run_batch(urls, lambda u: base + extra + [u], cwd=save_dir)

            elif choice in ("4", "6"):
                base = self._base_flags(_TMPL_PLAYLIST, archive)
                extra = ["--yes-playlist", "-x", "--audio-format", "mp3", "--audio-quality", "0"]
                self.run_batch(urls, lambda u: base + extra + [u], cwd=save_dir)

            elif choice in ("7",):
                base = self._base_flags(_TMPL_CHANNEL, archive)
                extra = ["-f", "bestvideo+bestaudio/best", "--merge-output-format", "mp4"]
                self.run_batch(urls, lambda u: base + extra + [u], cwd=save_dir)

            elif choice in ("8",):
                base = self._base_flags(_TMPL_CHANNEL, archive)
                extra = ["-x", "--audio-format", "mp3", "--audio-quality", "0"]
                self.run_batch(urls, lambda u: base + extra + [u], cwd=save_dir)

            elif choice == "9":
                print("\nCommon formats: best, worst, mp4, m4a")
                print("By resolution:  bestvideo[height<=1080]+bestaudio/best")
                fmt = input("Enter format string: ").strip()
                if not fmt:
                    continue
                base = self._base_flags(_TMPL_SINGLE, archive)
                self.run_command(base + ["-f", fmt, urls[0]], cwd=save_dir)

            input("\nPress Enter to return to menu...")


if __name__ == "__main__":
    try:
        app = EasyDownloader()
        app.menu()
    except KeyboardInterrupt:
        print("\nExiting...")
        sys.exit(0)
