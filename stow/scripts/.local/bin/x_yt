#!/usr/bin/env bash
# x_yt - Download video/audio with yt-dlp.

set -euo pipefail

MODE="video"
OUT_DIR="."
FORMAT=""
URL=""

usage() {
    cat <<'EOF'
Usage: x_yt [OPTIONS] URL
       x_yt menu

Download videos with yt-dlp.

Options:
  -a, --audio       Extract MP3 audio
  -p, --playlist    Treat URL as playlist
  -f, --format FMT  Custom yt-dlp format selector
  -o, --out DIR     Output directory (default: current directory)
  -h, --help        Show this help

Examples:
  x_yt https://youtu.be/...
  x_yt --audio --out ~/Music https://youtu.be/...
  x_yt --playlist https://youtube.com/playlist?list=...
EOF
}

downloader() {
    command -v yt-dlp >/dev/null 2>&1 && { echo yt-dlp; return; }
    command -v youtube-dl >/dev/null 2>&1 && { echo youtube-dl; return; }
    echo "Error: install yt-dlp first: python -m pip install yt-dlp" >&2
    exit 1
}

run_download() {
    local bin
    bin="$(downloader)"
    mkdir -p "$OUT_DIR"
    local args=(-o '%(title)s [%(id)s].%(ext)s')

    [[ "$MODE" == "playlist" ]] && args+=(--yes-playlist)
    if [[ "$MODE" == "audio" ]]; then
        args+=(-x --audio-format mp3 --audio-quality 0)
    elif [[ -n "$FORMAT" ]]; then
        args+=(-f "$FORMAT")
    else
        args+=(-f 'bestvideo+bestaudio/best' --merge-output-format mp4)
    fi

    echo "Running: $bin ${args[*]} $URL"
    (cd "$OUT_DIR" && "$bin" "${args[@]}" "$URL")
}

run_menu() {
    echo "x_yt"
    echo "1) Best quality video"
    echo "2) MP3 audio"
    echo "3) Playlist video"
    echo "4) Custom format"
    read -rp "Choice: " choice
    read -rp "URL: " URL
    read -rp "Output directory [.]: " OUT_DIR
    OUT_DIR="${OUT_DIR:-.}"
    case "$choice" in
        1) MODE="video" ;;
        2) MODE="audio" ;;
        3) MODE="playlist" ;;
        4) read -rp "Format selector: " FORMAT ;;
        *) echo "Invalid choice."; exit 1 ;;
    esac
    run_download
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        menu) run_menu; exit 0 ;;
        -a|--audio) MODE="audio"; shift ;;
        -p|--playlist) MODE="playlist"; shift ;;
        -f|--format) FORMAT="${2:-}"; shift 2 ;;
        -o|--out) OUT_DIR="${2:-.}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) URL="$1"; shift ;;
    esac
done

[[ -n "$URL" ]] || { usage; exit 1; }
run_download
