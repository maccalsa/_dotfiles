#!/usr/bin/env python3
# x_ctx - Generate PRD-driven AI coding context and workflow prompts.
"""
x_ctx

A single-file Python CLI for generating high-quality AI coding prompts from a PRD
and durable project context files.

It does not call an LLM.
It generates prompts, prints them by default, and can write or copy them on request.

Usage examples:

  x_ctx init
  x_ctx init --agents agents --cursor-rule
  x_ctx overview
  x_ctx architecture --stack nextjs
  x_ctx standards --stack nextjs
  x_ctx ui
  x_ctx tracker
  x_ctx burndown
  x_ctx feature "authentication"
  x_ctx next-feature
  x_ctx implement-next
  x_ctx compile-context
  x_ctx ship --branch feature/M0-project-setup --title "M0: project setup"
  x_ctx pr-approved 12
  x_ctx pr-comments 12 --branch feature/M0-project-setup
  x_ctx workflow
"""

from __future__ import annotations

import argparse
import platform
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Callable


APP_NAME = "x_ctx"

DEFAULT_PRD = "prd.md"
CONTEXT_DIR = "context"
FEATURES_DIR = "features"


# ---------------------------------------------------------------------------
# File templates
# ---------------------------------------------------------------------------

PRD_TEMPLATE = """# [Project Name]

## Overview

[One paragraph describing what this application does, who it is for, and what problem it solves.]

## Goals

1. [Goal one — specific and measurable]
2. [Goal two]
3. [Goal three]

## Core User Flow

1. [Step one — e.g. User signs in]
2. [Step two]
3. [Step three]
4. [Continue until the core flow is complete]

## Features

### [Feature Category One]

- [Feature description]
- [Feature description]

### [Feature Category Two]

- [Feature description]
- [Feature description]

## Scope

### In Scope

- [What you are building]
- [What you are building]

### Out of Scope

- [What you are explicitly not building]
- [What you are explicitly not building]

## Success Criteria

1. [Specific, verifiable condition — e.g. A signed-in user can create and open a project]
2. [Condition two]
3. [Condition three]
"""

PROGRESS_TRACKER_TEMPLATE = """# Progress Tracker

Update this file after every meaningful implementation change.

## Current Phase

- Not started

## Current Goal

- Define the project context.

## Completed

- None yet.

## In Progress

- None yet.

## Next Up

- Generate project overview from PRD.
- Generate architecture context.
- Generate code standards.
- Generate UI context.
- Define the first feature.

## Open Questions

- None yet.

## Architecture Decisions

- None yet.

## Session Notes

- Project has been initialised with x_ctx.
"""

BURNDOWN_TEMPLATE = """# Burndown

Track completion steps here. Keep this file procedural: what remains, what is in progress, what is blocked, and what is done.

Do not duplicate product facts, architecture decisions, API details, UI requirements, or feature scope here. Those belong in the PRD, context files, and feature specs.

## Current Milestone

- Not selected yet.

## Completion Steps

- [ ] Define project overview.
- [ ] Define architecture context.
- [ ] Define code standards.
- [ ] Define UI context.
- [ ] Specify first feature.
- [ ] Implement first feature slice.
- [ ] Validate and ship first slice.

## In Progress

- None yet.

## Blocked

- None yet.

## Done

- None yet.
"""

AGENT_ENTRYPOINT_TEMPLATE = """# Project Context

Before implementing, read the following files in order:

1. `{context_dir}/project-overview.md` - product definition, goals, features, and scope
2. `{context_dir}/architecture.md` - system structure, boundaries, storage model, and invariants
3. `{context_dir}/ui-context.md` - theme, colors, typography, and component conventions
4. `{context_dir}/code-standards.md` - implementation rules and conventions
5. `{context_dir}/progress-tracker.md` - current phase, completed work, open questions, and next steps
6. `{context_dir}/burndown.md` - procedural completion steps, current blockers, and done list

Update `{context_dir}/progress-tracker.md` after each meaningful implementation change.
Update `{context_dir}/burndown.md` when a planned step starts, blocks, or completes.

If implementation changes architecture, scope, UI direction, or standards, update the relevant context file before continuing.
"""

CURSOR_RULE_TEMPLATE = """---
description: Project context entrypoint
alwaysApply: true
---

Before implementing, read the project context files in `{context_dir}/`.
Treat those files as the source of truth for product intent, architecture, standards, UI decisions, and progress.
Use `{context_dir}/burndown.md` only for procedural step tracking; do not treat it as product or architecture fact.
"""



# ---------------------------------------------------------------------------
# Stack decorators
# ---------------------------------------------------------------------------

GENERAL_STANDARDS = """## General Engineering Standards

- Keep modules small, explicit, and single-purpose.
- Fix root causes rather than layering workarounds.
- Prefer boring, obvious code over clever abstractions.
- Do not mix unrelated concerns in the same component, service, route, or module.
- Validate external input at system boundaries before trusting it.
- Keep business rules close to the domain they affect.
- Do not introduce background work, queues, caches, or persistence unless the architecture context requires them.
- Prefer clear names over comments explaining unclear code.
- Every meaningful implementation change should update `context/progress-tracker.md`.
"""

STACK_DECORATORS: dict[str, str] = {
    "nextjs": """## Next.js / TypeScript Standards

- Use TypeScript strict mode.
- Default to Server Components.
- Add `use client` only where browser interactivity requires it.
- Keep route handlers focused on one responsibility.
- Validate request bodies before running logic.
- Enforce authentication and ownership before mutations.
- Keep database access outside UI components.
- Prefer small server-side functions over large route handlers.
- Use CSS variables and shared UI tokens rather than hardcoded styles.
- Do not introduce global client state unless there is a clear need.
""",
    "sveltekit": """## SvelteKit Standards

- Keep server-only logic in server routes, server load functions, or server modules.
- Validate external input before mutation.
- Use form actions for simple mutations where appropriate.
- Avoid putting persistence or secret-bearing code in client-side modules.
- Prefer stores only for genuinely shared client state.
- Keep components small and focused on presentation or local interaction.
""",
    "fastapi": """## FastAPI / Python Standards

- Use Pydantic models for request and response validation.
- Keep route handlers thin.
- Move business logic into services or domain modules.
- Use explicit dependency injection for database/session/auth concerns.
- Return predictable response shapes.
- Avoid global mutable state.
- Use type hints throughout.
- Keep long-running jobs out of request handlers unless explicitly required.
""",
    "spring-kotlin": """## Spring Boot / Kotlin Standards

- Keep controllers thin.
- Put business logic in services or domain components.
- Keep persistence concerns inside repositories/adapters.
- Validate request DTOs before use.
- Use explicit transaction boundaries.
- Avoid leaking JPA entities directly through API responses.
- Prefer constructor injection.
- Keep module boundaries explicit.
- Write integration tests for externally visible behaviour.
""",
    "go": """## Go Standards

- Keep packages small and named by responsibility.
- Prefer explicit structs and interfaces over clever generic abstractions.
- Keep HTTP handlers thin.
- Validate input at the boundary.
- Return errors with useful context.
- Avoid package-level mutable state unless unavoidable.
- Keep persistence behind explicit interfaces where it improves testability.
""",
    "elixir-phoenix": """## Elixir / Phoenix Standards

- Keep contexts as the main boundary for business logic.
- Keep LiveViews focused on interaction flow, not persistence detail.
- Validate and transform data through changesets.
- Prefer explicit message handling.
- Avoid hiding important state transitions.
- Use Oban or supervised processes for background work only when needed.
""",
}


# ---------------------------------------------------------------------------
# Core prompt templates
# ---------------------------------------------------------------------------

BASE_INSTRUCTIONS = """You are helping create project context files for an AI-assisted coding project.

Use the PRD below as the source of truth.

Rules:
- Do not invent unnecessary product scope.
- Make unresolved assumptions explicit.
- Prefer simple, practical architecture.
- Write clear Markdown.
- Output only the requested Markdown file contents.
- Do not include chatty explanation before or after the Markdown.
"""

PROMPT_TEMPLATES: dict[str, str] = {
    "overview": """{base}

Target file: `context/project-overview.md`

Create a concise but detailed project overview that can guide future AI coding sessions.

The overview must:
- preserve the intent of the PRD
- clarify the product shape
- avoid inventing unnecessary scope
- separate confirmed requirements from assumptions
- be useful as long-lived project memory

The file must use this structure:

# Project Overview

## Product Summary

Write one clear paragraph explaining:
- what the product is
- who it is for
- what problem it solves
- the main value proposition

## Target Users

Describe each user type:
- who they are
- what they need
- what success looks like for them

## Problem Being Solved

Explain:
- the current pain/problem
- why existing approaches are insufficient
- what the product improves

## Goals

List specific product goals.
Each goal should be measurable or observable where possible.

## Non-Goals

List things the project should not try to solve yet.

## Core User Flow

Describe the primary happy path step by step.
Include entry point, main actions, successful completion, and obvious failure/cancel paths.

## Main Features

Group features by area.
For each feature include:
- purpose
- user value
- whether it appears core, supporting, or future

## In Scope

List concrete work that belongs in the initial product.

## Out of Scope

List scope boundaries and tempting distractions to avoid.

## Success Criteria

Each criterion must be specific and verifiable.

## Important Assumptions

List assumptions separately from confirmed PRD facts.

## Open Questions

List missing decisions that need user input.

--- PRD START ---
{prd}
--- PRD END ---
""",
    "architecture": """{base}

Target file: `context/architecture.md`

Create architecture context for this project.

Your job is to define:
- the major system boundaries
- responsibilities of each area
- data ownership
- request/data flow
- invariants the codebase must never violate
- where complexity is allowed vs forbidden

The goal is not to create enterprise architecture.
The goal is to create a practical, enforceable structure that AI coding agents can safely follow.

If the PRD does not specify a technology choice:
- leave sensible placeholders
- explain tradeoffs briefly
- list unresolved decisions under Open Questions
- do not pretend the stack is already decided

Preferred stack hint:
{stack_hint}

Stack-specific guidance:
{stack_rules}

The file must use this structure:

# Architecture Context

## Architectural Style

Describe:
- overall architecture style
- major execution model
- whether the system is monolith, modular, service-oriented, event-driven, etc.
- where state lives
- what the runtime model looks like

## Stack

| Layer | Technology | Responsibility | Why |
| --- | --- | --- | --- |

Explain why each major technology exists.

## System Boundaries

For every major folder, module, or boundary include:
- responsibility
- what is allowed inside
- what must not live there
- inbound dependencies allowed
- outbound dependencies allowed
- example files/components likely to exist there

Example:

- `app/api/`
  - owns HTTP request boundaries
  - validates requests
  - must not contain business logic
  - may call services
  - must not directly query persistence

## Request/Data Flow

Describe:
- how requests move through the system
- validation boundaries
- business logic boundaries
- persistence boundaries
- response shaping
- background work, if any

## Storage Model

For each storage mechanism describe:
- what lives there
- ownership rules
- lifecycle expectations
- data that must never live there

## Auth and Access Model

Describe:
- authentication mechanism
- ownership rules
- mutation permissions
- multi-user assumptions
- trust boundaries

## Core Data Concepts

Describe the major entities/resources in plain English.
Do not fully design schemas unless the PRD clearly requires it.

For each concept:
- purpose
- ownership
- relationships
- lifecycle

## External Integrations

Describe:
- APIs/services used
- sync vs async behaviour
- retry expectations
- failure handling expectations

## Performance Expectations

Describe:
- expected scale
- latency sensitivity
- expensive operations
- caching assumptions
- background processing assumptions

## Invariants

These are hard architectural rules the codebase must never violate.

Each invariant must:
- be enforceable
- be specific
- prevent architectural drift

Example:
- Request handlers must never run long-lived background jobs directly.
- UI components must not directly mutate persistence.

## Failure Modes

Describe:
- likely failure scenarios
- acceptable degradation behaviour
- what must fail loudly
- what may retry gracefully

## Open Questions

List unresolved architecture decisions separately.

--- PRD START ---
{prd}
--- PRD END ---
""",
    "standards": """{base}

Target file: `context/code-standards.md`

Create practical coding standards for this project.

The standards must:
- guide AI coding agents
- reduce architectural drift
- improve consistency
- prevent overengineering
- improve maintainability

Avoid vague advice like:
- "write clean code"
- "follow best practices"

Every rule should be:
- actionable
- enforceable
- specific
- useful during implementation

Preferred stack hint:
{stack_hint}

General standards:
{general_standards}

Stack-specific standards:
{stack_rules}

The file must use this structure:

# Code Standards

## Engineering Philosophy

Describe:
- what kinds of complexity are acceptable
- what kinds are discouraged
