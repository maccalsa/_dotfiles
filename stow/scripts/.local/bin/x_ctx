# ---------------------------------------------------------------------------
# Git / PR workflow prompt templates
# ---------------------------------------------------------------------------

SHIP_WORK_TEMPLATE = """Ship the current work.

Branch name: {branch}
PR title: {title}

Steps:
1. Confirm all acceptance criteria for the current milestone slice pass. Run the relevant tests/checks before committing.
2. Inspect the working tree and summarise the files changed.
3. Stage only files that belong to this slice. Do not include unrelated changes, secrets, temporary files, debug code, or local environment files.
4. Create one focused commit from the current work. Use imperative mood and match the recent git log style.
5. Create branch `{branch}` from the current HEAD if it does not already exist. If already on that branch, continue.
6. Push `{branch}` to origin with upstream set.
7. Open a PR targeting `main` with title `{title}` and a short body containing:
   - What changed
   - How to verify, including commands and manual checks
   - Link to the milestone, feature spec, or work order if one exists
{body_section}
8. Print the PR URL when done.

Rules:
- Do not merge.
- Do not checkout `main` after opening the PR.
- Do not start new feature work.
- I will review the PR.
"""

PR_APPROVED_TEMPLATE = """PR #{pr_number} has been reviewed and merged on GitHub.

Steps:
1. Fetch from origin.
2. Checkout `main`.
3. Pull latest `main` so local matches `origin/main`.
4. Confirm the merge commit, squash commit, or rebased commits for PR #{pr_number} are on `main`.
5. Delete the local feature branch if it still exists and was merged.
6. Optionally delete the remote feature branch if it was not auto-deleted by GitHub.
7. Report:
   - current branch
   - latest commit on `main`
   - whether the merged work is present locally
   - whether the progress tracker reflects the merged work

Rules:
- Do not start new feature work unless I say so.
- Do not modify unrelated files.
"""

PR_COMMENTS_TEMPLATE = """Read review comments on PR #{pr_number} and make the necessary adjustments.

Steps:
1. Use `gh` to fetch PR #{pr_number} details, review comments, and inline code comments.
2. Summarise each actionable item before changing code.
3. If not already on the feature branch, checkout {branch_instruction}.
4. Pull latest from origin for that branch.
5. Fix every actionable comment.
6. Skip nitpicks I have explicitly resolved, dismissed, or marked as won't fix.
7. Run the relevant tests/checks and fix regressions.
8. Commit with a message that references the review, for example: `Address PR #{pr_number} review feedback`.
9. Push to the same branch.
10. Reply on GitHub to each addressed thread with a one-line note of what changed, using `gh` if possible.
11. Print a checklist:
    - comment
    - status: done / deferred / needs my input
    - file or area changed

Rules:
- Do not merge.
- Do not checkout `main`.
- Do not start new feature work.
- I will re-review.
"""

WORKFLOW_GUIDE_TEMPLATE = """# Git & PR Workflow — Prompt Templates

This is the post-implementation loop for AI-assisted development.

The project context may already be loaded through Cursor rules, compiled context,
or explicit files. These prompts do not repeat the full context.

## Working model

1. Develop locally on `main` or your current working branch.
2. When a slice is complete, generate a ship prompt.
3. The agent creates one focused commit, creates/pushes a feature branch, and opens a PR.
4. You review the PR on GitHub.
5. After review:
   - if merged, sync local `main`
   - if comments need changes, address them on the same feature branch

## Workflow diagram

```text
main / local dev
  │
  ▼  x_ctx ship
feature/M{N}-slug  ──push──▶  PR on GitHub
  │
  ▼  you review
  ├─ merge ──▶  x_ctx pr-approved ──▶  checkout main, pull
  └─ comments ─▶  x_ctx pr-comments ──▶  fix, push, re-review
```

## Commands

```bash
x_ctx ship --branch feature/M0-project-setup --title "M0: project setup"
x_ctx pr-approved 12
x_ctx pr-comments 12 --branch feature/M0-project-setup
```

## Rules baked into the prompts

- Do not merge.
- Do not include unrelated files.
- Do not include secrets, debug code, or local environment files.
- One finished slice equals one focused commit.
- You review the PR.
- The agent only syncs back to `main` after the PR is merged.
"""


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

@dataclass
class AppPaths:
    root: Path
    prd: Path
    context: Path
    features: Path
    burndown: Path


@dataclass
class ClipboardResult:
    success: bool
    backend: str | None
    details: list[str]


def get_paths(prd_name: str = DEFAULT_PRD) -> AppPaths:
    root = Path.cwd()
    context = root / CONTEXT_DIR
    return AppPaths(
        root=root,
        prd=root / prd_name,
        context=context,
        features=context / FEATURES_DIR,
        burndown=context / "burndown.md",
    )


def slugify(value: str) -> str:
    value = value.strip().lower()
    value = re.sub(r"[^a-z0-9]+", "-", value)
    value = re.sub(r"-+", "-", value)
    return value.strip("-") or "feature"


def read_file(path: Path, required: bool = True) -> str:
    if not path.exists():
        if required:
            die(f"Missing required file: {path}")
        return ""
    return path.read_text(encoding="utf-8")


def write_file_if_missing(path: Path, content: str) -> bool:
    if path.exists():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return True


def die(message: str, code: int = 1) -> None:
    print(f"Error: {message}", file=sys.stderr)
    raise SystemExit(code)


def available_stacks() -> str:
    return ", ".join(sorted(STACK_DECORATORS.keys()))


def get_stack_rules(stack: str | None) -> tuple[str, str]:
    if not stack:
        return "None provided.", "No stack-specific rules provided."
    key = stack.strip().lower()
    rules = STACK_DECORATORS.get(key)
    if not rules:
        die(f"Unknown stack '{stack}'. Available stacks: {available_stacks()}")
    return key, rules.strip()


def copy_to_clipboard(text: str) -> ClipboardResult:
    """
    Try to copy to clipboard using common platform tools.
    Returns diagnostic detail so callers can report useful failures.
    """
    system = platform.system().lower()

    commands: list[list[str]] = []
    details: list[str] = []

    if system == "darwin":
        commands.append(["pbcopy"])
    elif system == "windows":
        commands.append(["clip"])
    else:
        commands.extend([
            ["wl-copy"],
            ["xclip", "-selection", "clipboard"],
            ["xsel", "--clipboard", "--input"],
        ])

    for cmd in commands:
        if shutil.which(cmd[0]) is None:
            details.append(f"{cmd[0]}: not found")
            continue
        try:
            subprocess.run(
                cmd,
                input=text.encode("utf-8"),
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            return ClipboardResult(True, " ".join(cmd), details)
        except Exception as exc:
            details.append(f"{' '.join(cmd)}: failed ({exc})")
            continue

    return ClipboardResult(False, None, details)


def should_preview(args: argparse.Namespace) -> bool:
    """Bare commands print content; targeted outputs stay quiet unless --preview is set."""
    if getattr(args, "no_preview", False):
        return False
    if getattr(args, "preview", False):
        return True
    return not (getattr(args, "copy", False) or getattr(args, "out", None))


def output_prompt(
    prompt: str,
    *,
    copy: bool = False,
    out_file: Path | None = None,
    preview: bool = True,
) -> None:
    prompt = prompt.strip() + "\n"

    if preview:
        print(prompt)

    if out_file:
        out_file.parent.mkdir(parents=True, exist_ok=True)
        out_file.write_text(prompt, encoding="utf-8")
        print(f"[{APP_NAME}] Wrote output: {out_file} ({len(prompt):,} chars)", file=sys.stderr)

    if copy:
        result = copy_to_clipboard(prompt)
        if result.success:
            print(
                f"[{APP_NAME}] Copied output to clipboard via {result.backend} ({len(prompt):,} chars).",
                file=sys.stderr,
            )
        else:
            print(f"[{APP_NAME}] Clipboard unavailable.", file=sys.stderr)
            for detail in result.details:
                print(f"[{APP_NAME}]   {detail}", file=sys.stderr)


def _rel(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def _context_files(paths: AppPaths) -> list[tuple[str, Path]]:
    files: list[tuple[str, Path]] = [
        ("PRD", paths.prd),
        ("Project Overview", paths.context / "project-overview.md"),
        ("Architecture", paths.context / "architecture.md"),
        ("Code Standards", paths.context / "code-standards.md"),
        ("UI Context", paths.context / "ui-context.md"),
        ("Progress Tracker", paths.context / "progress-tracker.md"),
        ("Burndown", paths.burndown),
    ]

    feature_files = sorted(paths.features.glob("*.md")) if paths.features.exists() else []
    for feature_file in feature_files:
        files.append((f"Feature File: {feature_file.name}", feature_file))

    return files


def compile_context(paths: AppPaths, *, inline: bool = False) -> str:
    existing = [(title, path) for title, path in _context_files(paths) if path.exists()]

    if not existing:
        die("No context files found. Run `x_ctx init` and add a PRD first.")

    if not inline:
        lines = [
            "# Project Context References",
            "",
            "Read these files directly. Treat them as the source of truth instead of relying on copied inline content.",
            "",
            "## Source Files",
            "",
        ]
        for title, path in existing:
            lines.append(f"- `{_rel(path, paths.root)}` - {title}")
        lines.extend([
            "",
            "## Instructions",
            "",
            "- Use `context/burndown.md` for procedural step tracking only.",
            "- Do not copy facts from `context/burndown.md` into feature specs or architecture context.",
            "- If a fact is missing, read the relevant source file before deciding.",
        ])
        return "\n".join(lines)

    sections: list[tuple[str, Path]] = [
        ("PRD", paths.prd),
        ("Project Overview", paths.context / "project-overview.md"),
        ("Architecture", paths.context / "architecture.md"),
        ("Code Standards", paths.context / "code-standards.md"),
        ("UI Context", paths.context / "ui-context.md"),
        ("Progress Tracker", paths.context / "progress-tracker.md"),
        ("Burndown", paths.burndown),
    ]

    chunks: list[str] = []

    for title, path in sections:
        content = read_file(path, required=False).strip()
        if content:
            chunks.append(f"# {title}\n\n{content}")

    feature_files = sorted(paths.features.glob("*.md")) if paths.features.exists() else []
    for feature_file in feature_files:
        content = read_file(feature_file, required=False).strip()
        if content:
            chunks.append(f"# Feature File: {feature_file.name}\n\n{content}")

    return "\n\n---\n\n".join(chunks)


def build_basic_prompt(
    kind: str,
    paths: AppPaths,
    stack: str | None = None,
    style: str | None = None,
    feature_name: str | None = None,
) -> str:
    prd = read_file(paths.prd)
    stack_hint, stack_rules = get_stack_rules(stack)

    template = PROMPT_TEMPLATES[kind]

    feature_title = feature_name or ""
    feature_slug = slugify(feature_title)

    return template.format(
        base=BASE_INSTRUCTIONS.strip(),
        prd=prd.strip(),
        stack_hint=stack_hint,
        stack_rules=stack_rules,
        general_standards=GENERAL_STANDARDS.strip(),
        style_hint=style or "None provided.",
        feature_title=feature_title,
        feature_slug=feature_slug,
    )


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_init(args: argparse.Namespace) -> None:
    paths = get_paths(args.prd)

    created: list[str] = []
    paths.context.mkdir(exist_ok=True)
    paths.features.mkdir(parents=True, exist_ok=True)

    if write_file_if_missing(paths.prd, PRD_TEMPLATE):
        created.append(str(paths.prd))

    if write_file_if_missing(paths.context / "progress-tracker.md", PROGRESS_TRACKER_TEMPLATE):
        created.append(str(paths.context / "progress-tracker.md"))

    if write_file_if_missing(paths.burndown, BURNDOWN_TEMPLATE):
        created.append(str(paths.burndown))

    placeholder = paths.features / ".gitkeep"
    if write_file_if_missing(placeholder, ""):
        created.append(str(placeholder))

    agent_files = {
        "agents": ["AGENTS.md"],
        "claude": ["CLAUDE.md"],
        "both": ["AGENTS.md", "CLAUDE.md"],
        "none": [],
    }[args.agents]
    for file_name in agent_files:
        path = paths.root / file_name
        if write_file_if_missing(path, AGENT_ENTRYPOINT_TEMPLATE.format(context_dir=CONTEXT_DIR)):
            created.append(str(path))

    if args.cursor_rule:
        cursor_rule = paths.root / ".cursor" / "rules" / "project.mdc"
        if write_file_if_missing(cursor_rule, CURSOR_RULE_TEMPLATE.format(context_dir=CONTEXT_DIR)):
            created.append(str(cursor_rule))

    print(f"{APP_NAME} initialised.")
    if created:
        print("\nCreated:")
        for item in created:
            print(f"  - {item}")
    else:
        print("\nNothing created; files already exist.")

    print("\nNext:")
    print(f"  1. Edit {paths.prd.name}")
    print("  2. Run: x_ctx overview")
    print("  3. Run prompts with --copy or --out to avoid terminal scrollback noise")


def cmd_prompt(kind: str) -> Callable[[argparse.Namespace], None]:
    def run(args: argparse.Namespace) -> None:
        paths = get_paths(args.prd)
        prompt = build_basic_prompt(
            kind=kind,
            paths=paths,
            stack=getattr(args, "stack", None),
            style=getattr(args, "style", None),
        )
        output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))
    return run


def cmd_feature(args: argparse.Namespace) -> None:
    paths = get_paths(args.prd)
    prompt = build_basic_prompt(
        kind="feature",
        paths=paths,
        feature_name=args.name,
    )
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_compile_context(args: argparse.Namespace) -> None:
    paths = get_paths(args.prd)
    compiled = compile_context(paths, inline=args.inline)
    output_prompt(compiled, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_next_feature(args: argparse.Namespace) -> None:
    paths = get_paths(args.prd)
    compiled = compile_context(paths, inline=args.inline)
    prompt = NEXT_FEATURE_TEMPLATE.format(compiled_context=compiled.strip())
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_implement_next(args: argparse.Namespace) -> None:
    paths = get_paths(args.prd)
    compiled = compile_context(paths, inline=args.inline)
    prompt = IMPLEMENT_NEXT_TEMPLATE.format(compiled_context=compiled.strip())
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_session(args: argparse.Namespace) -> None:
    paths = get_paths(args.prd)
    compiled = compile_context(paths, inline=args.inline)
    prompt = SESSION_TEMPLATE.format(compiled_context=compiled.strip())
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_list_stacks(args: argparse.Namespace) -> None:
    print("Available stacks:")
    for stack in sorted(STACK_DECORATORS.keys()):
        print(f"  - {stack}")


def cmd_ship(args: argparse.Namespace) -> None:
    body_section = ""
    if args.body:
        bullets = "\n".join(f"   - {item}" for item in args.body)
        body_section = f"\n   Additional PR body notes:\n{bullets}"

    prompt = SHIP_WORK_TEMPLATE.format(
        branch=args.branch,
        title=args.title,
        body_section=body_section,
    )
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_pr_approved(args: argparse.Namespace) -> None:
    prompt = PR_APPROVED_TEMPLATE.format(pr_number=args.pr_number)
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_pr_comments(args: argparse.Namespace) -> None:
    if args.branch:
        branch_instruction = f"`{args.branch}`"
    else:
        branch_instruction = "the PR head branch"

    prompt = PR_COMMENTS_TEMPLATE.format(
        pr_number=args.pr_number,
        branch_instruction=branch_instruction,
    )
    output_prompt(prompt, copy=args.copy, out_file=args.out, preview=should_preview(args))


def cmd_workflow(args: argparse.Namespace) -> None:
    output_prompt(WORKFLOW_GUIDE_TEMPLATE, copy=args.copy, out_file=args.out, preview=should_preview(args))


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def add_output_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("-c", "--copy", action="store_true", help="Copy the generated output to the clipboard.")
    parser.add_argument("--out", type=Path, help="Write the generated output to this file.")
    parser.add_argument(
        "--preview",
        action="store_true",
        help="Print generated output even when using --copy or --out.",
    )
    parser.add_argument(
        "--no-preview",
        action="store_true",
        help="Do not print generated output. Kept for existing scripts.",
    )


def add_context_mode_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--inline",
        action="store_true",
        help="Embed full context file contents instead of listing file references.",
    )


def add_common_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--prd",
        default=DEFAULT_PRD,
        help=f"Path to PRD file relative to current directory. Default: {DEFAULT_PRD}",
    )
    add_output_args(parser)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="Generate AI coding prompts from a PRD and context files.",
    )

    sub = parser.add_subparsers(dest="command", required=True)

    init = sub.add_parser("init", help="Create starter PRD and context folders.")
    init.add_argument("--prd", default=DEFAULT_PRD)
    init.add_argument(
        "--agents",
        choices=["agents", "claude", "both", "none"],
        default="none",
        help="Create an agent entrypoint file that points to the generated context.",
    )
    init.add_argument(
        "--cursor-rule",
        action="store_true",
        help="Create .cursor/rules/project.mdc pointing to the generated context.",
    )
    init.set_defaults(func=cmd_init)

    for name in ["overview", "tracker", "burndown"]:
        p = sub.add_parser(name, help=f"Generate prompt for {name}.")
        add_common_args(p)
        p.set_defaults(func=cmd_prompt(name))

    architecture = sub.add_parser("architecture", help="Generate architecture context prompt.")
    add_common_args(architecture)
    architecture.add_argument("--stack", help=f"Stack hint. Available: {available_stacks()}")
    architecture.set_defaults(func=cmd_prompt("architecture"))

    standards = sub.add_parser("standards", help="Generate code standards prompt.")
    add_common_args(standards)
    standards.add_argument("--stack", help=f"Stack hint. Available: {available_stacks()}")
    standards.set_defaults(func=cmd_prompt("standards"))

    ui = sub.add_parser("ui", help="Generate UI context prompt.")
    add_common_args(ui)
    ui.add_argument("--style", help='Optional style hint, e.g. "dark technical workspace".')
    ui.set_defaults(func=cmd_prompt("ui"))

    feature = sub.add_parser("feature", help="Generate prompt for a specific feature.")
    add_common_args(feature)
    feature.add_argument("name", help='Feature name, e.g. "authentication".')
    feature.set_defaults(func=cmd_feature)

    compile_cmd = sub.add_parser("compile-context", help="Print/copy compiled project context.")
    add_common_args(compile_cmd)
    add_context_mode_args(compile_cmd)
    compile_cmd.set_defaults(func=cmd_compile_context)

    next_feature = sub.add_parser("next-feature", help="Generate prompt for the next feature spec.")
    add_common_args(next_feature)
    add_context_mode_args(next_feature)
    next_feature.set_defaults(func=cmd_next_feature)

    implement_next = sub.add_parser("implement-next", help="Generate coding-agent prompt for the next implementation step.")
    add_common_args(implement_next)
    add_context_mode_args(implement_next)
    implement_next.set_defaults(func=cmd_implement_next)

    session = sub.add_parser("session", help="Generate a session-start prompt.")
    add_common_args(session)
    add_context_mode_args(session)
    session.set_defaults(func=cmd_session)

    ship = sub.add_parser("ship", help="Generate prompt to commit, branch, push, and open a PR.")
    ship.add_argument("--branch", required=True, help="Feature branch name, e.g. feature/M0-project-setup.")
    ship.add_argument("--title", required=True, help="PR title.")
    ship.add_argument(
        "--body",
        action="append",
        help="Optional extra PR body bullet. Can be supplied multiple times.",
    )
    add_output_args(ship)
    ship.set_defaults(func=cmd_ship)

    pr_approved = sub.add_parser("pr-approved", help="Generate prompt to sync local main after a merged PR.")
    pr_approved.add_argument("pr_number", help="GitHub PR number.")
    add_output_args(pr_approved)
    pr_approved.set_defaults(func=cmd_pr_approved)

    pr_comments = sub.add_parser("pr-comments", help="Generate prompt to address GitHub PR review comments.")
    pr_comments.add_argument("pr_number", help="GitHub PR number.")
    pr_comments.add_argument("--branch", help="Feature branch name. Optional; agent can infer PR head branch.")
    add_output_args(pr_comments)
    pr_comments.set_defaults(func=cmd_pr_comments)

    workflow = sub.add_parser("workflow", help="Print/copy the Git and PR workflow guide.")
    add_output_args(workflow)
    workflow.set_defaults(func=cmd_workflow)

    stacks = sub.add_parser("stacks", help="List available stack decorators.")
    stacks.set_defaults(func=cmd_list_stacks)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        args.func(args)
        return 0
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
