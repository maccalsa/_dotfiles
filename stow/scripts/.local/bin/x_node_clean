#!/usr/bin/env bash
set -euo pipefail

# x_node_clean - Remove node_modules and lockfile, reinstall
# Usage: x_node_clean [OPTIONS] [DIR]

DRY_RUN=false
FORCE=false
RESET_LOCKFILE=false

usage() {
    cat <<'EOF'
Usage: x_node_clean [OPTIONS] [DIR]

  Removes node_modules, then reinstalls with npm/pnpm/yarn/bun.
  DIR defaults to current directory.

Options:
  --reset-lockfile  Remove lockfiles before reinstalling
  --dry-run         Print what would happen without deleting/installing
  -f, --force       Skip confirmation
  -h, --help        Show this help
EOF
    exit 0
}

cmd_clean() {
    local dir="${1:-.}"
    cd "$dir" || exit 1

    [[ -f package.json ]] || { echo "No package.json found in $(pwd)."; exit 1; }
    [[ -d node_modules ]] || { echo "No node_modules found."; exit 1; }

    local pkg="npm"
    [[ -f pnpm-lock.yaml ]] && pkg="pnpm"
    [[ -f yarn.lock ]] && pkg="yarn"
    [[ -f bun.lockb ]] && pkg="bun"

    echo "Using $pkg"
    if $RESET_LOCKFILE; then
        echo "Lockfiles will be removed before reinstalling."
    else
        echo "Lockfiles will be preserved. Use --reset-lockfile to remove them."
    fi

    if $DRY_RUN; then
        echo "Would remove: $(pwd)/node_modules"
        $RESET_LOCKFILE && echo "Would remove lockfiles: package-lock.json pnpm-lock.yaml yarn.lock bun.lockb"
        echo "Would run: $pkg install"
        return 0
    fi

    if ! $FORCE; then
        read -rp "Remove node_modules and reinstall? (y/N): " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    fi

    rm -rf node_modules
    if $RESET_LOCKFILE; then
        rm -f package-lock.json pnpm-lock.yaml yarn.lock bun.lockb 2>/dev/null
    fi

    case "$pkg" in
        npm)  npm install ;;
        pnpm) pnpm install ;;
        yarn) yarn install ;;
        bun)  bun install ;;
    esac
    echo "Done."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reset-lockfile) RESET_LOCKFILE=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        -f|--force) FORCE=true; shift ;;
        -h|--help) usage ;;
        *) break ;;
    esac
done

cmd_clean "${1:-.}"
