#!/usr/bin/env bash
set -euo pipefail

# x_password - Generate random password
# Usage: x_password [LEN] [--alnum|--symbols]

MODE="symbols"

usage() {
    cat <<'EOF'
Usage: x_password [LEN] [--alnum|--symbols]

  Generates random password. LEN defaults to 24.
  Copies to clipboard if wl-copy, xclip, or xsel is available.

Options:
  --alnum    Use letters and numbers only
  --symbols  Use letters, numbers, and common symbols (default)

  Examples:
    x_password
    x_password 32
EOF
    exit 0
}

gen_pass() {
    local len="${1:-24}"
    [[ "$len" =~ ^[0-9]+$ && "$len" -gt 0 ]] || { echo "Length must be a positive integer." >&2; exit 1; }
    python3 - "$len" "$MODE" <<'PY'
import secrets
import string
import sys

length = int(sys.argv[1])
mode = sys.argv[2]
charset = string.ascii_letters + string.digits
if mode == "symbols":
    charset += "!@#$%^&*()_+-=[]{}|;:,.<>?"
print("".join(secrets.choice(charset) for _ in range(length)))
PY
}

LEN=24
while [[ $# -gt 0 ]]; do
    case "$1" in
        --alnum) MODE="alnum"; shift ;;
        --symbols) MODE="symbols"; shift ;;
        -h|--help) usage ;;
        *) LEN="$1"; shift ;;
    esac
done

pass=$(gen_pass "$LEN")
echo "$pass"

if command -v wl-copy &>/dev/null; then
    echo -n "$pass" | wl-copy 2>/dev/null && echo "(copied to clipboard)" || true
elif command -v xclip &>/dev/null; then
    echo -n "$pass" | xclip -selection clipboard 2>/dev/null && echo "(copied to clipboard)" || true
elif command -v xsel &>/dev/null; then
    echo -n "$pass" | xsel --clipboard 2>/dev/null && echo "(copied to clipboard)" || true
fi
