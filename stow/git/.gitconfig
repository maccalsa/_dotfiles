[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
    last = log -1 HEAD
    unstage = reset HEAD --
    amend = commit --amend
    cm = !git add -A && git commit -m
    save = !git add -A && git commit -m 'SAVEPOINT'
    wip = !git add -A && git commit -m 'WIP'
    undo = reset HEAD~1 --mixed
    rollback = reset --hard

    # Short logs (complements lg)
    l5 = log --oneline -5
    l10 = log --oneline -10

    # Safe force-push (refuses if remote moved; not plain --force)
    pf = push --force-with-lease

    # Stage / diff
    aa = add --all
    ds = diff --staged
    patch = add -p

    # Modern branch checkout (Git 2.23+)
    sw = switch

    # Stash
    sp = stash push
    pop = stash pop

    # Recent branches by last commit
    recent-branches = branch --sort=-committerdate

    # Remote cleanup (drops stale tracking branches)
    prune = remote prune origin

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    autocrlf = input
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

#[merge]
 #   tool = vimdiff

#[mergetool "vimdiff"]
 #   cmd = vimdiff $BASE $LOCAL $REMOTE $MERGED
 #   trustExitCode = true

[push]
    default = current
    autoSetupRemote = true

[pull]
    rebase = false

[init]
    defaultBranch = main

[rerere]
    enabled = true

[include]
    path = ~/.private_gitconfig
  
[user]
  email = maccalsa@googlemail.com
  name = Stuart MacCallum

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true # use n and N to move between different diff sections
  side-by-side = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[credential]
	helper = cache

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
