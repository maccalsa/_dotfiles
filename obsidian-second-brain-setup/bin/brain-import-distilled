#!/usr/bin/env python3
"""
Import distilled/how-to, distilled/project-ideas, and distilled/useful-knowledge
into the Obsidian vault's 00-Inbox with YAML front matter joined from manifest.json.

Uses SECOND_BRAIN (default: ~/SecondBrain). Set e.g. SECOND_BRAIN=$HOME/dev/SecondBrain.

Distilled data: uses $DISTILLED_ROOT if set; else ./distilled under the current working
directory when manifest.json exists there. Use --distilled-root for any other layout.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import date
from pathlib import Path

CATEGORIES = ("how-to", "project-ideas", "useful-knowledge")
TARGET_PATH_RE = re.compile(
    r"/(how-to|project-ideas|useful-knowledge)/([^/]+\.md)$", re.IGNORECASE
)
HTML_COMMENT_RE = re.compile(r"<!--([\s\S]*?)-->\s*\Z")


def resolve_distilled_root(explicit: Path | None) -> Path | None:
    """Pick distilled/ folder: --distilled-root, $DISTILLED_ROOT, then cwd ./distilled."""
    if explicit is not None:
        p = explicit.expanduser().resolve()
        if not (p / "manifest.json").is_file():
            raise ValueError(f"Missing manifest: {p / 'manifest.json'}")
        return p
    env = os.environ.get("DISTILLED_ROOT", "").strip()
    if env:
        p = Path(env).expanduser().resolve()
        if (p / "manifest.json").is_file():
            return p
        raise ValueError(f"DISTILLED_ROOT set but missing manifest: {p / 'manifest.json'}")
    cwd_dist = (Path.cwd() / "distilled").resolve()
    if (cwd_dist / "manifest.json").is_file():
        return cwd_dist
    return None


def yaml_quote(value: str) -> str:
    if value == "":
        return '""'
    if any(c in value for c in "\n\r\"") or value.strip() != value:
        escaped = value.replace("\\", "\\\\").replace('"', '\\"')
        return f'"{escaped}"'
    if any(c in value for c in ": #") or value in ("true", "false", "null"):
        return f'"{value}"'
    return value


def build_manifest_index(manifest: list[dict]) -> dict[tuple[str, str], dict]:
    """Map (category, basename) -> manifest row; prefer higher value_score on collision."""
    idx: dict[tuple[str, str], dict] = {}
    for row in manifest:
        tp = row.get("target_path")
        if not tp or not isinstance(tp, str):
            continue
        m = TARGET_PATH_RE.search(tp.replace("\\", "/"))
        if not m:
            continue
        cat, base = m.group(1), m.group(2)
        key = (cat, base)
        prev = idx.get(key)
        if prev is None:
            idx[key] = row
            continue
        s_new = row.get("value_score")
        s_old = prev.get("value_score")
        try:
            if s_new is not None and s_old is not None and int(s_new) > int(s_old):
                idx[key] = row
        except (TypeError, ValueError):
            pass
    return idx


def extract_trailing_comment(text: str) -> tuple[str, str | None]:
    m = HTML_COMMENT_RE.search(text.rstrip())
    if not m:
        return text, None
    body = text[: m.start()].rstrip()
    return body, m.group(1).strip()


def note_title(meta: dict | None, raw_body: str, stem: str) -> str:
    if meta and meta.get("title"):
        return str(meta["title"]).strip()
    for line in raw_body.splitlines():
        line = line.strip()
        if line.startswith("# "):
            return line[2:].strip()
    return stem.replace("-", " ").title()


def format_front_matter(
    meta: dict | None,
    category: str,
    created: str,
) -> str:
    lines = [
        "---",
        "type: note",
        "status: needs-review",
        f"created: {created}",
        "source: distilled",
        f"distilled_category: {category}",
        "confidence: low",
    ]
    if meta:
        cid = meta.get("conversation_id")
        if cid:
            lines.append(f"conversation_id: {yaml_quote(str(cid))}")
        out = meta.get("outcome")
        if out:
            lines.append(f"distiller_outcome: {yaml_quote(str(out))}")
        vs = meta.get("value_score")
        if vs is not None:
            lines.append(f"value_score: {vs}")
        sf = meta.get("source_file")
        if sf:
            lines.append(f"distiller_source_file: {yaml_quote(str(sf))}")
    lines.append("tags:")
    lines.append("  - inbox")
    lines.append("  - distilled")
    lines.append(f"  - distilled-{category}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def build_note_content(
    meta: dict | None,
    category: str,
    raw_text: str,
    stem: str,
) -> str:
    body_wo_comment, comment = extract_trailing_comment(raw_text)
    title = note_title(meta, body_wo_comment, stem)
    created = date.today().isoformat()
    fm = format_front_matter(meta, category, created)
    src_ctx = comment if comment else "(No HTML source comment in distilled file.)"
    triage = (
        "After import: restructure, merge duplicates, fix front matter, "
        "then move out of Inbox using the playbook in your dotfiles repo: "
        "`obsidian-second-brain-setup/docs/inbox-triage-after-import.md`."
    )
    return (
        f"{fm}\n"
        f"# {title}\n\n"
        "## Summary\n\n\n"
        "## Why this matters\n\n\n"
        "## Distilled content\n\n"
        f"{body_wo_comment.strip()}\n\n"
        "## Source / context\n\n"
        f"{src_ctx}\n\n"
        "## Links\n\n\n"
        "## Follow-up\n\n"
        "- [ ] Review this note\n"
        f"- [ ] {triage}\n"
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Import distilled markdown into Second Brain 00-Inbox."
    )
    parser.add_argument(
        "--distilled-root",
        type=Path,
        default=None,
        help="Folder with how-to/, manifest.json, etc. Default: $DISTILLED_ROOT, "
        "else ./distilled from cwd if manifest exists.",
    )
    parser.add_argument(
        "--vault",
        type=Path,
        default=Path(os.environ.get("SECOND_BRAIN", Path.home() / "SecondBrain")),
        help="Vault root (default: $SECOND_BRAIN or ~/SecondBrain)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print planned writes only; do not create files",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Overwrite destination if it already exists",
    )
    args = parser.parse_args()

    try:
        distilled = resolve_distilled_root(args.distilled_root)
    except ValueError as e:
        print(e, file=sys.stderr)
        return 1
    if distilled is None:
        cwd_try = Path.cwd() / "distilled" / "manifest.json"
        print(
            "Could not find distilled/manifest.json under the current directory.\n"
            f"  Tried: {cwd_try}\n"
            "  cd into the directory that contains distilled/, or set DISTILLED_ROOT, "
            "or pass --distilled-root PATH",
            file=sys.stderr,
        )
        return 1
    manifest_path = distilled / "manifest.json"

    with manifest_path.open(encoding="utf-8") as f:
        manifest = json.load(f)
    if not isinstance(manifest, list):
        print("manifest.json must be a JSON array.", file=sys.stderr)
        return 1

    idx = build_manifest_index(manifest)
    inbox = args.vault / "00-Inbox"
    if not args.dry_run:
        inbox.mkdir(parents=True, exist_ok=True)

    written = skipped = 0
    for category in CATEGORIES:
        d = distilled / category
        if not d.is_dir():
            print(f"Skip missing directory: {d}", file=sys.stderr)
            continue
        for src in sorted(d.glob("*.md")):
            key = (category, src.name)
            meta = idx.get(key)
            dest_name = f"distilled-{category}-{src.stem}.md"
            dest = inbox / dest_name
            if dest.exists() and not args.force:
                print(f"skip exists: {dest}")
                skipped += 1
                continue
            raw = src.read_text(encoding="utf-8")
            content = build_note_content(meta, category, raw, src.stem)
            if args.dry_run:
                print(f"would write: {dest} ({len(content)} bytes)")
            else:
                dest.write_text(content, encoding="utf-8")
                print(dest)
            written += 1

    print(
        f"\nDone. written={written} skipped={skipped} vault={args.vault}",
        file=sys.stderr,
    )
    if written and not args.dry_run:
        print(
            "Next: brain-graph (refresh Graphify) after you review a batch.",
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
